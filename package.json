{
  "name": "@johnhenry/dialback",
  "version": "0.1.0",
  "description": "Reverse proxy HTTP requests over web sockets -- an agent dials out, the server dials back through that connection to reach it",
  "main": "index.mjs",
  "type": "module",
  "types": "types/types.d.ts",
  "exports": {
    ".": {
      "types": "./types/types.d.ts",
      "default": "./index.mjs"
    },
    "./browsermesh": {
      "types": "./types/browsermesh.d.ts",
      "default": "./transports/browsermesh.mjs"
    },
    "./transports/handshake": {
      "types": "./types/handshake.d.ts",
      "default": "./transports/handshake.mjs"
    },
    "./handshake": {
      "types": "./types/handshake.d.ts",
      "default": "./transports/handshake.mjs"
    },
    "./server": {
      "types": "./types/types.d.ts",
      "default": "./server.mjs"
    },
    "./agent": {
      "types": "./types/types.d.ts",
      "default": "./agent.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test:node": "node --test test/node.test.mjs",
    "test:deno": "deno test --allow-all test/deno.test.ts",
    "test:int": "node test/integration.test.mjs",
    "test:browsermesh": "node --test test/browsermesh.test.mjs",
    "test:exports": "node --test test/exports.test.mjs",
    "test:all": "node --run test:node && node --run test:deno ",
    "test": "node --run test:node",
    "start": "node server.mjs",
    "test:browser": "node --test test/browser-bundle.test.mjs",
    "test:close": "node --test test/close.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/dialback.git"
  },
  "keywords": [
    "websocket",
    "reverse-proxy",
    "reverse-tunnel",
    "socket",
    "reverse",
    "proxy",
    "http",
    "request",
    "response"
  ],
  "author": "John Henry",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johnhenry/dialback/issues"
  },
  "homepage": "https://opensource.johnhenry.me/dialback/",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@johnhenry/webwire": "^0.0.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@johnhenry/browsermesh-netway": ">=0.0.1",
    "@johnhenry/browsermesh-primitives": ">=0.2.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/browsermesh-netway": {
      "optional": true
    },
    "@johnhenry/browsermesh-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/browsermesh-netway": "^0.0.1",
    "@johnhenry/browsermesh-primitives": "^0.2.0",
    "@types/node": "18.16.19",
    "esbuild": "^0.28.0"
  },
  "imports": {
    "#node-listener": {
      "node": "./util/node-listener.mjs",
      "default": "./util/node-listener.browser.mjs"
    },
    "#events": {
      "node": "./util/emitter.node.mjs",
      "default": "./util/emitter.mjs"
    },
    "#websocket": {
      "node": "./util/websocket.node.mjs",
      "default": "./util/websocket.mjs"
    }
  }
}
